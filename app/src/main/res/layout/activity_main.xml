<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/quez_screen_background">

    <!-- Main content area -->
    <FrameLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/contentPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/megapixel"
            android:text="Statistics"
            android:textColor="#434343"
            android:textSize="24sp" />

    </FrameLayout>

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/nav_bar_background">

        <!-- Review -->
        <TextView
            android:id="@+id/navReview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/megapixel"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Review"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/nav_item_background"
            android:textColor="@color/nav_item_text_color" />

        <!-- Stats -->
        <TextView
            android:id="@+id/navStats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/megapixel"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Stats"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/nav_item_background"
            android:textColor="@color/nav_item_text_color" />

        <!-- Settings -->
        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/megapixel"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Settings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/nav_item_background"
            android:textColor="@color/nav_item_text_color" />

        <!-- User -->
        <TextView
            android:id="@+id/navUser"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/megapixel"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="User"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/nav_item_background"
            android:textColor="@color/nav_item_text_color" />

    </LinearLayout>

</LinearLayout>